# Dockerfile для Security Service
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

# Copy all backend files
COPY . .

# Build only security-service
RUN mvn clean package -pl security-service -DskipTests

# Runtime stage
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Copy built JAR from builder
COPY --from=builder /app/security-service/target/security-service-*.jar app.jar

EXPOSE 8082

CMD ["java", "-jar", "app.jar"]

